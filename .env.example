# Copy to .env at the project root. Used by rag_core (ingestion, generation)
# whether you're running the notebook, build_index.py, or the backend.

# At least one of these, or generation falls back to a deterministic
# extractive mode. Get a Groq key at https://console.groq.com
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: silences the Hugging Face Hub rate-limit warning on BGE-M3 /
# MedCPT downloads and gets faster/higher-limit downloads. Leaving it unset
# still works exactly the same, just with the warning.
HF_TOKEN=

# Optional overrides — sensible defaults live in rag_core/config.py.
# GUIDELINE_PDF_PATH=/path/to/2026-guidelines-for-the-early-detection-of-prostate-cancer.pdf
# INDEX_STORE_DIR=./index_store
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=175
# RAG_CONFIDENCE_THRESHOLD=6.5
# RAG_GLOSSARY_HIT_CONFIDENCE_FLOOR=5.0
# RAG_DEFINITIONAL_FRONT_MATTER_BOOST=6.0
# RAG_EVIDENCE_RELEVANCE_THRESHOLD=0.5
