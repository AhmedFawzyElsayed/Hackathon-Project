# Copy to .env and fill in. Never commit the real .env file.

# At least one LLM key, or generation falls back to a deterministic
# extractive mode (still cited, just not LLM-written prose).
GROQ_API_KEY=
OPENAI_API_KEY=

# Comma-separated list is fine too if you customize app/core/config.py's
# parsing — default here matches the Vite dev server.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
